rules_version = '2';

// PlantSense AI — Cloud Storage security rules.
// Users may read/write ONLY their own diagnosis images. Uploads must be JPEG
// and under 4 MB. No public read access.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/diagnoses/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/jpe?g');
      allow delete: if isOwner(uid);
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
