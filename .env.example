# =============================================================================
# PlantSense AI — Configuration template (PLACEHOLDERS ONLY — no real secrets)
# =============================================================================
# The Flutter client is configured with --dart-define at build/run time.
# NEVER put real secret keys in the committed client build. The Gemini key is
# only ever read server-side by the Cloud Function.
#
# Example run:
#   flutter run \
#     --dart-define=DEMO_MODE=true \
#     --dart-define=USE_GEMINI_BACKEND=true \
#     --dart-define=GEMINI_BACKEND_URL=https://<region>-<project>.cloudfunctions.net/geminiProxy
# -----------------------------------------------------------------------------

# Launch without any backend/Firebase — everything is served by local fakes.
DEMO_MODE=true

# When false, the app uses the demo/fake services and never touches Firebase.
USE_FIREBASE=false

# When true, chat/diagnosis calls go through the secure backend proxy (preferred).
USE_GEMINI_BACKEND=true

# Secure Cloud Function proxy endpoint (safe to ship — it is not a secret).
GEMINI_BACKEND_URL=https://REGION-PROJECT_ID.cloudfunctions.net/geminiProxy

# DEV-ONLY direct Gemini access. Leave empty. Do NOT commit a real key.
# Only used when USE_GEMINI_BACKEND=false AND ALLOW_DIRECT_GEMINI=true.
ALLOW_DIRECT_GEMINI=false
GEMINI_DEV_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# functions/.env  (server-side only — never bundled in the app)
# =============================================================================
# GEMINI_API_KEY=your-real-server-side-key   # set via `firebase functions:secrets:set GEMINI_API_KEY`
