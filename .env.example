# =============================================================================
# PlantSense AI — Configuration template (PLACEHOLDERS ONLY — no real secrets)
# =============================================================================
# The Flutter client is configured with --dart-define at build/run time.
# NEVER put real secret keys in the committed client build. The Groq key is
# only ever read server-side by the Cloud Function.
#
# Example run (uses the secure backend proxy):
#   flutter run \
#     --dart-define=DEMO_MODE=false \
#     --dart-define=USE_FIREBASE=true \
#     --dart-define=USE_AI_BACKEND=true \
#     --dart-define=AI_BACKEND_URL=https://<region>-<project>.cloudfunctions.net/aiProxy
# -----------------------------------------------------------------------------

# Launch without any backend/Firebase — everything is served by local fakes.
DEMO_MODE=true

# When false, the app uses the demo/fake services and never touches Firebase.
USE_FIREBASE=false

# When true, AI calls go through the secure Cloud Function proxy (preferred).
USE_AI_BACKEND=true

# Secure Cloud Function proxy endpoint (safe to ship — it is not a secret).
AI_BACKEND_URL=https://REGION-PROJECT_ID.cloudfunctions.net/aiProxy

# DEV-ONLY direct Groq access. Leave disabled. Do NOT commit a real key.
# Only used when USE_AI_BACKEND=false AND ALLOW_DIRECT_GROQ=true.
ALLOW_DIRECT_GROQ=false
GROQ_API_KEY=
# Groq model overrides (defaults shown; update if Groq's free lineup changes).
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# =============================================================================
# functions/.env  (server-side only — never bundled in the app)
# =============================================================================
# Set the real key as a Cloud Functions secret, NOT in this file:
#   firebase functions:secrets:set GROQ_API_KEY
# Get a free key at https://console.groq.com/keys
