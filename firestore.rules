rules_version = '2';

// PlantSense AI — Firestore security rules.
// Principle: every document lives under users/{uid} and is readable/writable
// ONLY by that authenticated user. No public access. UID ownership can never be
// reassigned by a client write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Common field guards.
    function stringUnder(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= max);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // The document id must match the authenticated uid; the stored uid field
      // (if present) must equal it too — ownership cannot be reassigned.
      allow create, update: if isOwner(uid)
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == uid)
        && stringUnder('displayName', 100)
        && stringUnder('email', 254)
        && stringUnder('locale', 8);
      allow delete: if isOwner(uid);

      match /chats/{chatId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.role in ['user', 'assistant']
            && stringUnder('text', 8000);
          allow update, delete: if isOwner(uid);
        }
      }

      match /diagnoses/{diagnosisId} {
        allow read, write: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      match /plants/{plantId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
