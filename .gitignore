# Flutter/Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store

# Secrets & local config — NEVER commit
.env
*.env
!.env.example
# Local build-time defines holding the Groq dev key (never commit the real one).
dart_defines.json
# NOTE: lib/firebase_options.dart is committed as a non-functional PLACEHOLDER so
# the project compiles in demo mode. Running `flutterfire configure` overwrites it
# with your real (non-secret) config. Do not commit real service-account files.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
android/key.properties
android/app/*.keystore
android/app/*.jks
**/service-account*.json
functions/.env
functions/node_modules/
functions/lib/

# Generated localization (regenerate with flutter gen-l10n)
lib/l10n/generated/

# -----------------------------------------------------------------------------
# Generated platform projects.
#
# These are NOT committed by design: each developer regenerates them with their
# own org/applicationId via tool/setup_platforms.sh (or .ps1), and the README's
# "Platform configuration" section documents that.
#
# They are ignored rather than merely undocumented because the setup script
# produces ~200 files, and without this a routine `git add -A` silently commits
# the whole runner project along with one developer's applicationId. Use
# `git add -f` if you ever genuinely need to track native changes.
# -----------------------------------------------------------------------------
/android/
/ios/
/web/
/linux/
/macos/
/windows/

# Android (kept for anyone who force-adds android/ above)
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh

# Coverage
coverage/
